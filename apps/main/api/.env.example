# Runtime
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb
MAX_UPLOAD_SIZE=41943040
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE_MB=40

# Application secrets (generate unique values for every deployment)
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# Firebase server credentials
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=service-account@example.invalid
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
FIREBASE_API_KEY=your-firebase-api-key
# AuthService uses the legacy verifyPassword endpoint under this base URL.
FIREBASE_AUTH_API_BASE=https://www.googleapis.com/identitytoolkit/v3/relyingparty
FIREBASE_FIRESTORE_API_BASE=https://firestore.googleapis.com/v1
FIREBASE_APPCHECK_API_BASE=https://firebaseappcheck.googleapis.com/v1
FIREBASE_SECURETOKEN_API_BASE=https://securetoken.googleapis.com/v1
FIREBASE_STORAGE_API_BASE=https://firebasestorage.googleapis.com/v0

# Upstream application API
LOCKET_API_BASE=https://api.example.com

# Optional short-lived device session values. Never commit real values.
FIREBASE_APPCHECK_TOKEN=
FIREBASE_INSTANCE_ID_TOKEN=
LOCKET_APP_CHECK_TOKEN=
LOCKET_APP_CHECK_DEVICE_TOKEN=
LOCKET_APP_CHECK_DEVICE_ID=
LOCKET_DEVICE_ID_TOKEN=
LOCKET_DEVICE_ANALYTICS=
LOCKET_DEVICE_BAGGAGE=
LOCKET_DEVICE_SENTRY_TRACE=

# Optional services
STORAGE_API_URL=http://localhost:5003
STORAGE_INTERNAL_TOKEN=change-me
REDIS_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
WEATHER_PROVIDER=

# Optional moment information service
LOCKET_INFO_MOMENT_API_BASE=
LOCKET_INFO_MOMENT_API_KEY=
LOCKET_INFO_MOMENT_MEMBER_TOKEN=
LOCKET_INFO_MOMENT_HEADERS_JSON=

# Optional slot monitor
SLOT_MONITOR_WORKER_ENABLED=false
SLOT_POLL_INTERVAL_MS=30000

# Optional image generation providers
AI_FILTER_ACTIVE_MODEL=kira-nano-banana
AI_FILTER_ALLOWED_IMAGE_HOSTS=
KIRA_API_BASE_URL=https://api.example.com
KIRA_API_KEY=
KIRA_IMAGE_MODEL=gemini-2.5-flash-image
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-1-schnell
