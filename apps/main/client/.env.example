# Application services
VITE_BASE_API_URL=http://localhost:5000
VITE_BETA_API_URL=http://localhost:5000
VITE_AUTH_API_URL=http://localhost:5000
VITE_DATA_API_URL=http://localhost:5000
VITE_PAYMENT_API_URL=http://localhost:5000
VITE_STORAGE_API_URL=http://localhost:5003

# Optional external services
VITE_LOCKET_API_URL=https://api.example.com
VITE_LOCKET_BETA_API_URL=https://api.example.com
VITE_EXPORTS_API_URL=https://exports.example.com
VITE_CONVERTS_API_URL=https://converts.example.com
VITE_EXTENS_API_URL=https://extensions.example.com
VITE_CDN_URL=https://cdn.example.com

# Public browser keys (do not place server secrets in VITE_* variables)
VITE_VAPID_PUBLIC_KEY=your-public-vapid-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
VITE_PUBLIC_API_KEY=your-public-api-key

# Firebase browser configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:replace-me
