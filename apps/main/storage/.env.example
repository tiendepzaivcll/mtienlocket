PORT=5003
CORS_ORIGINS=http://localhost:5173

# Firebase project that ISSUES the browser's ID tokens (may differ from API admin project)
FIREBASE_AUTH_PROJECT_ID=your-token-issuing-project-id

# Cloud object storage
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-access-key
R2_SECRET_KEY=your-secret-key
R2_BUCKET=your-bucket-name

# Server-only shared token: set the same value on storage and main API services
STORAGE_INTERNAL_TOKEN=replace-with-a-long-random-token

# Optional cleanup job; only used by /api/autoCleanByDay
CLEANER_KEY_ID=your-cleaner-key-id

# Required publicly readable R2 bucket/custom-domain URL (not the S3 endpoint)
MEDIA_API_URL=https://media.example.com
